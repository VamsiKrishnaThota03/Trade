# Copy to .env and adjust. Real environment variables take precedence over .env.
# The defaults below match a local XAMPP/MAMP MySQL install.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=project
DB_USER=root
DB_PASS=
# Optional: full PDO DSN; overrides DB_HOST/DB_PORT/DB_NAME (e.g. sqlite:/path/to/trade.sqlite)
DB_DSN=
# Show PHP errors in the browser (local development only)
APP_DEBUG=false
